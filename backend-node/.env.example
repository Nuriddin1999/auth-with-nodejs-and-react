# --- Server (names kept from the Django version, so the old .env works as is) ---
# Generate: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
# Keep the old value when migrating: it signs JWTs (active sessions) and code hashes.
DJANGO_SECRET_KEY=change-me
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
CORS_ALLOWED_ORIGINS=http://localhost:5173
LOG_LEVEL=INFO

# Shared cache for login codes and rate limits (required with several server processes).
# Empty: in-memory cache, fine for a single server process.
REDIS_URL=

# --- Google ---------------------------------------------------------------
# Google Cloud Console -> APIs & Services -> Credentials -> OAuth client ID (Web)
GOOGLE_CLIENT_ID=

# --- Facebook -------------------------------------------------------------
# developers.facebook.com -> your app -> Settings -> Basic
FACEBOOK_APP_ID=
FACEBOOK_APP_SECRET=
FACEBOOK_GRAPH_VERSION=v21.0
# Until the Facebook app is set up: "Continue with Facebook" asks for an email and
# sends a code (needs working email). Ignored once FACEBOOK_APP_ID is set.
FACEBOOK_EMAIL_FALLBACK=False

# --- Telegram -------------------------------------------------------------
# @BotFather -> /newbot
TELEGRAM_BOT_TOKEN=
# Production: long random string + `npm run telegram-webhook -- --url https://.../api/auth/telegram/webhook/`
# Empty (development): the bot reads messages with getUpdates while the sign-in page is open.
TELEGRAM_WEBHOOK_SECRET=
# Max age (s) of Telegram Login Widget data (alternative /api/auth/telegram/ endpoint)
TELEGRAM_AUTH_MAX_AGE=86400

# --- Email codes (sign up / password reset) -------------------------------
# Without EMAIL_HOST, emails are only printed to the server console.
# Gmail: EMAIL_HOST=smtp.gmail.com, EMAIL_HOST_USER=you@gmail.com,
#        EMAIL_HOST_PASSWORD=<16-char App Password>  (myaccount.google.com/apppasswords)
EMAIL_HOST=
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
# 587 + TLS (default) or 465 + SSL: set EMAIL_USE_SSL=True
EMAIL_PORT=587
EMAIL_USE_SSL=False
# Optional; defaults to "Auth <EMAIL_HOST_USER>"
DEFAULT_FROM_EMAIL=
# Seconds a code stays valid
EMAIL_CODE_TTL=120

# --- Test modes (work only with DJANGO_DEBUG=True) ---------------------
# Every email code is this value and no email is sent (sign up works without SMTP).
EMAIL_TEST_CODE=
# Provider buttons without keys sign in fake users after code 12345.
SOCIAL_AUTH_MOCK=False

# Optional: PORT=8000, HOST=127.0.0.1, DATABASE_PATH=db.sqlite3
