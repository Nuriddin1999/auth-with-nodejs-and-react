VITE_API_URL=http://localhost:8000/api
# Same value as GOOGLE_CLIENT_ID on the backend
VITE_GOOGLE_CLIENT_ID=
# Same value as FACEBOOK_APP_ID on the backend
VITE_FACEBOOK_APP_ID=
VITE_FACEBOOK_GRAPH_VERSION=v21.0
# Bot username without "@", e.g. my_site_login_bot
VITE_TELEGRAM_BOT_NAME=

# Test mode: buttons without keys sign in fake users (needs SOCIAL_AUTH_MOCK=True on backend)
VITE_MOCK_AUTH=false

# Until the Facebook app is set up: "Continue with Facebook" signs in with an emailed
# code (backend needs FACEBOOK_EMAIL_FALLBACK=True). Ignored once VITE_FACEBOOK_APP_ID is set.
VITE_FACEBOOK_EMAIL_FALLBACK=false
